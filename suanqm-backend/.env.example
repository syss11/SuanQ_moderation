# 数据库配置
# DB_TYPE 可选值: sqljs, mysql
DB_TYPE=mysql

# SQLJS 配置（当 DB_TYPE=sqljs 时使用）
DB_STORAGE=./data/database.sqlite

# MySQL 配置（当 DB_TYPE=mysql 时使用）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# 通用数据库配置
DB_SYNCHRONIZE=true
DB_LOGGING=false

# 登录密码配置
AUTH_PASSWORD=your_auth_password

# 应用配置
APP_PORT=6065
APP_ENV=development
APP_BASE_URL=http://localhost:6065